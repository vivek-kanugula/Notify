{
  "uid": "notify-overview",
  "title": "Notify Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Notifications created (rate)",
      "datasource": { "type": "prometheus", "uid": "notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "options": {},
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "notify-prometheus" }, "expr": "sum by (channel) (rate(notify_notifications_created_total[5m])) or (sum by (channel) (notify_notifications_created_total) * 0) or vector(0)", "legendFormat": "{{channel}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Delivery success rate (5m)",
      "datasource": { "type": "prometheus", "uid": "notify-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "noValue": "100%" }, "overrides": [] },
      "options": {},
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "notify-prometheus" }, "expr": "(sum(rate(notify_delivery_attempts_total{result_status=\"SUCCESS\"}[5m])) / clamp_min(sum(rate(notify_delivery_attempts_total[5m])), 1)) or (sum(notify_delivery_attempts_total{result_status=\"SUCCESS\"}) / clamp_min(sum(notify_delivery_attempts_total), 1)) or vector(1)" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "notify-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "options": {},
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "notify-prometheus" }, "expr": "sum by (status) (notify_queue_depth) or vector(0)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
