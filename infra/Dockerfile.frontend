# Stage 1: Build
FROM node:24-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve with unprivileged NGINX (non-root)
FROM nginxinc/nginx-unprivileged:alpine

# Run explicitly as unprivileged nginx user (UID 101)
USER 101

# Copy hardened production NGINX reverse-proxy configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy production static assets with unprivileged ownership
COPY --from=builder --chown=101:101 /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
