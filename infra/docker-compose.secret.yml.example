# Webhook signing-secret override for Compose (/ ).
#
# WHY A SEPARATE FILE: a service can only receive NOTIFY_WEBHOOK_SECRET_KEY if the Compose file declares it, and
# `docker compose config` — which scripts/gate.ps1 runs and prints — resolves and prints whatever is declared. That
# is true for BOTH declaration forms: `environment: - NOTIFY_WEBHOOK_SECRET_KEY` prints the value it took from the
# host environment, and `env_file:` has its file's contents inlined into the printed config. Verified on
# Docker Compose with a disposable test value. So the key is declared here, in a file the gate never loads, and the
# committed infra/docker-compose.yml stays free of it.
#
# USE IT (copy this file to docker-compose.secret.yml first; that name is git-ignored):
#   PowerShell:
#     $env:NOTIFY_WEBHOOK_SECRET_KEY = '<base64 of 32 CSPRNG bytes>'
#     docker compose -f infra/docker-compose.yml -f infra/docker-compose.secret.yml --profile core --profile app up -d
#   bash:
#     export NOTIFY_WEBHOOK_SECRET_KEY='<base64 of 32 CSPRNG bytes>'
#     docker compose -f infra/docker-compose.yml -f infra/docker-compose.secret.yml --profile core --profile app up -d
#
# NEVER pass this override to a command whose output is shared, including `docker compose config` and the gate.
# The `:?` form below makes Compose refuse to start rather than silently running without a key.
#
# Generate the value with a CSPRNG (see .env.example); never commit it.
# THIS FILE CARRIES THE KEY ONLY. It deliberately does NOT set NOTIFY_WORKER_WEBHOOK_ENABLED: supplying an
# encryption key is configuration, not activation. The base infra/docker-compose.yml already forwards that flag with
# a `false` default (extended), so with this override alone the webhook delivery worker stays DISABLED while
# the configuration API, secret rotation and the test ping all work.
#
# Turning the worker on is a separate, explicit action: set NOTIFY_WORKER_WEBHOOK_ENABLED=true in the same shell.
# On a shared development environment that also requires the read-only channel/event census, the activation
# preflight, and the user's authorization — it is not part of key setup.
services:
  # The service name must match infra/docker-compose.yml, where it is `backend`. Any other name makes Compose add a
  # second, empty service and refuse the whole project with
  #   service "<name>" has neither an image nor a build context specified: invalid compose project
  backend:
    environment:
      NOTIFY_WEBHOOK_SECRET_KEY: ${NOTIFY_WEBHOOK_SECRET_KEY:?set NOTIFY_WEBHOOK_SECRET_KEY in the shell that starts Compose}
