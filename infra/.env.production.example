# ==========================================================================
# Notify Production Environment Variables
# ==========================================================================
# Copy this file to `.env` in the same directory and fill in real values.
# NEVER commit the `.env` file to version control.
#
# Generate secrets with a CSPRNG:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
#   bash/macOS:  openssl rand -base64 32
# ==========================================================================

# ── Domain & TLS (Caddy) ──────────────────────────────────────────────────
# The fully qualified domain name Caddy will obtain a Let's Encrypt certificate for.
# Also used as the base for NOTIFY_PUBLIC_URL and NOTIFY_FRONTEND_URL (https://${DOMAIN}).
DOMAIN=notify.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=notify
POSTGRES_USER=notify_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── JWT Signing ───────────────────────────────────────────────────────────
# HS256 key, minimum 32 characters. Used for tenant and admin JWTs.
NOTIFY_JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET_MIN_32_CHARS

# ── Admin Bootstrap ───────────────────────────────────────────────────────
# First-boot only: seeds the initial operator account. Change the password
# immediately after first login.
NOTIFY_ADMIN_EMAIL=admin@yourcompany.com
NOTIFY_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_10

# ── Email (Resend) ────────────────────────────────────────────────────────
NOTIFY_EMAIL_PROVIDER=resend
NOTIFY_RESEND_API_KEY=re_CHANGE_ME
NOTIFY_MAIL_FROM=notifications@yourdomain.com

# ── Webhook ───────────────────────────────────────────────────────────────
# Base64 of 32 CSPRNG bytes. Required for webhook channel.
NOTIFY_WEBHOOK_SECRET_KEY=CHANGE_ME_BASE64_WEBHOOK_SECRET

# ── Workers (enable explicitly) ───────────────────────────────────────────
# Each worker is disabled by default (). Enable only after the
# activation preflight for that channel is complete.
NOTIFY_WORKER_EMAIL_ENABLED=false
NOTIFY_WORKER_WEBHOOK_ENABLED=false
NOTIFY_WORKER_INAPP_ENABLED=false

# ── Infrastructure Workers ────────────────────────────────────────────────
NOTIFY_OUTBOX_RELAY_ENABLED=true
NOTIFY_RECONCILER_ENABLED=true
NOTIFY_RECOVERY_ENABLED=false
NOTIFY_RESILIENCE_ENABLED=false

# ── DLQ Consumers ─────────────────────────────────────────────────────────
NOTIFY_DLQ_CONSUMER_ENABLED=false
NOTIFY_DLQ_DLT_CONSUMER_ENABLED=false

# ── Observability ─────────────────────────────────────────────────────────
NOTIFY_TRACE_SAMPLING=0.1
NOTIFY_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# ── Grafana (obs profile only) ────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

