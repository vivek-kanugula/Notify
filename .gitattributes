# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.java text diff=java eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
