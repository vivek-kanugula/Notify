# ==============================================================================
# Notify Environment Configuration Template (Placeholders only - no real secrets)
# Copy to .env for local development with your custom values
# ==============================================================================

# Core Monolith Role (all | api | worker)
NOTIFY_ROLE=all

# Application URLs
NOTIFY_PUBLIC_URL=http://localhost:8080
NOTIFY_FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=notify
POSTGRES_USER=notify_user
POSTGRES_PASSWORD=placeholder_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/notify
SPRING_DATASOURCE_USERNAME=notify_user
SPRING_DATASOURCE_PASSWORD=placeholder_db_password

# Cache & In-Memory (Redis 7)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Event Broker (Kafka KRaft)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security & Secrets (Must be changed in production / staging)
# 256-bit secret for HS256 JWT access tokens
NOTIFY_JWT_SECRET=placeholder_hs256_secret_key_minimum_32_characters_long
# 32-byte hex key for AES-256-GCM signing secret encryption
NOTIFY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Seeded Admin Identity (First boot only)
NOTIFY_ADMIN_EMAIL=admin@notify.local
NOTIFY_ADMIN_PASSWORD=placeholder_admin_password_min_10_chars

# External Providers (Fake provider used for local/test)
NOTIFY_EMAIL_PROVIDER=fake
NOTIFY_RESEND_API_KEY=re_placeholder_resend_api_key
NOTIFY_MAIL_FROM=notifications@example.com

# Delivery Workers (Disabled by default)
NOTIFY_WORKER_EMAIL_ENABLED=false
NOTIFY_WORKER_WEBHOOK_ENABLED=false

# Webhook signing-secret encryption key: base64 of 32 random bytes, NO default.
# Generate via: openssl rand -base64 32
NOTIFY_WEBHOOK_SECRET_KEY=

# Demo & Sandbox settings
NOTIFY_DEMO_PUBLIC=false
