meta {
 name: Create Notification
 type: http
 seq: 1
}

post {
 url: {{baseUrl}}/api/v1/notifications
 body: json
 auth: bearer
}

auth:bearer {
 token: {{token}}
}

headers {
 Content-Type: application/json
 Idempotency-Key: test-idem-key-001
}

body:json {
 {
 "channel": "EMAIL",
 "recipient": "user@example.com",
 "subject": "Order #1234 Confirmed",
 "body": "Hello! Your order has been placed successfully."
 }
}
